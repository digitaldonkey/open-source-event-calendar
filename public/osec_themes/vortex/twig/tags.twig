<li class="ai1ec-dropdown ai1ec-tag-filter
    {% if selected_tag_ids is not empty %}ai1ec-active{% endif %}">
    <a class="ai1ec-dropdown-toggle" data-toggle="ai1ec-dropdown">
        <i class="ai1ec-fa ai1ec-fa-tags" aria-hidden="true"></i>
        <span class="ai1ec-clear-filter ai1ec-tooltip-trigger"
            data-href="{{ clear_filter }}"
            {{ data_type | raw }}
            title="{{ text_clear_tag_filter }}">
            <i class="ai1ec-fa ai1ec-fa-remove"></i>
        </span>
        {{ text_tags }}
        <span class="ai1ec-caret"></span>
    </a>
    <div class="ai1ec-dropdown-menu osec-taxonomy-filter">
        {% include 'taxonomy-filter-select.twig' with {
            terms: tags,
            selected_ids: selected_tag_ids,
            label: text_tags,
            a11y_label: text_filter_by_tag
        } %}
    </div>
</li>
