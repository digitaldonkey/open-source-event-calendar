<div class="osec-taxonomy-filter ai1ec-tag-filter{% if selected_tag_ids is not empty %} ai1ec-active{% endif %}">
    {% include 'taxonomy-filter-select.twig' with {
        terms: tags,
        selected_ids: selected_tag_ids,
        label: text_tags,
        a11y_label: text_filter_by_tag,
        clear_label: text_clear_all_tags,
        remove_label: text_remove_term,
        search_in_list: true,
        load_on_close: true,
        apply_label: text_apply,
        not_applied_label: text_not_applied
    } %}
</div>
