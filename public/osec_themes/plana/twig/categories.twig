<div class="osec-taxonomy-filter ai1ec-category-filter{% if selected_cat_ids is not empty %} ai1ec-active{% endif %}">
    {% include 'taxonomy-filter-select.twig' with {
        terms: categories,
        selected_ids: selected_cat_ids,
        label: text_categories,
        a11y_label: text_filter_by_category,
        clear_label: text_clear_all_categories,
        remove_label: text_remove_term,
        search_in_list: true,
        load_on_close: true,
        apply_label: text_apply,
        not_applied_label: text_not_applied
    } %}
</div>
