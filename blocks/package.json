{
	"name": "osec-blocks",
	"version": "0.3.0",
	"private": true,
	"description": "Open Source Event Calendar blocks: classic calendar and React Big Calendar.",
	"author": "digitaldonkey",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"start": "wp-scripts start --blocks-manifest",
		"test:unit": "wp-scripts test-unit-js",
		"add": "npx @wordpress/create-block --namespace open-source-event-calendar --variant dynamic --no-plugin",
		"add-static": "npx @wordpress/create-block --namespace open-source-event-calendar --no-plugin"
	},
	"dependencies": {
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/core-data": "^8.1.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/html-entities": "^4.56.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/url": "^4.56.0",
		"dayjs": "^1.11.23",
		"react-big-calendar": "1.19.3",
		"react-datepicker": "^8.10.0",
		"react-loadable": "^5.5.0",
		"react-select": "^5.10.2",
		"react-tiny-popover": "^8.1.6"
	},
	"devDependencies": {
		"@wordpress/scripts": "^36.0.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	}
}
