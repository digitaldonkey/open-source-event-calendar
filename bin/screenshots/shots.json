    {"file": "screenshot-7.png", "caption": "Cache Settings", "admin": true, "path": "/wp-admin/edit.php?post_type=osec_event&page=osec-admin-settings", "scroll_to": "#osec_event_features", "scroll_offset": 6, "width": 1280, "height": 1830},
    {"file": "screenshot-8.png", "caption": "Mobile Agenda View", "path": "{calendar}action~agenda/exact_date~{anchor}/", "width": 480, "height": 800, "mobile": true,
