#!/bin/bash

## Description: Open Source Event Calendar visual regression: approve screenshots of a review page (the reviewed current image becomes the baseline).
## Usage: osec-approve [dev|claude|try_<name>] [--set=<baseline set>] <ref> [<ref> ...]
## Example: ddev osec-approve --set=local chromium/plana/month-1280.png\nddev osec-approve try_pw --set=local admin/admin-events.png firefox/vortex/print-day.png

# Copy to .ddev/commands/web/ of the DDEV project (see integration_tests/visual_regression/README.md).
# The reference IDs and ready-made commands are on the review page (review/<set>/index.html). The previous baseline
# is kept in uploads/osec-visual-regression/backups/approved/<date_time>/.

. /var/www/html/wp-content/plugins/open-source-event-calendar/bin/ddev/osec-lib.sh || exit 1
osec_site "$@"
set -- "${OSEC_ARGS[@]}"

osec_npm_ready "$OSEC_PLUGIN_DIR/integration_tests"
cd "$OSEC_PLUGIN_DIR/integration_tests/visual_regression" || exit 1
exec node lib/approve.js "$@"
