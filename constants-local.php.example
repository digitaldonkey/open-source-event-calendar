<?php
/**
 * You may override by providing a constants-local.php at plugin root dir.
 *
 * For a comprehensive list  of Constants see constants.php.
 *
 * Local constants supersede.
 */
function osec_initiate_constants_local($osec_base_dir, $osec_base_url) {

  if (!defined('OSEC_DEBUG')) {
    define('OSEC_DEBUG', TRUE);
  }

  /**
   * Set TRUE if you want to PURGE ALL DATA on uninstall.
  */
  if (!defined('OSEC_UNINSTALL_PLUGIN_DATA')) {
    define(
      'OSEC_UNINSTALL_PLUGIN_DATA', FALSE);
  }

  /**
   * DDEV: feeds served by this dev site fail with "cURL error 60". WordPress checks
   * certificates against its own CA bundle, which lacks the mkcert CA; the
   * container's system bundle trusts it.
   */
  if (function_exists('add_filter')) {
    add_filter('http_request_args', function ($args, $url) {
      if (str_ends_with((string) wp_parse_url($url, PHP_URL_HOST), '.ddev.site')) {
        $args['sslcertificates'] = '/etc/ssl/certs/ca-certificates.crt';
      }
      return $args;
    }, 10, 2);
  }
}
